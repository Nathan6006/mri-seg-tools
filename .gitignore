# No imaging data or study metadata in this repo, ever.
*.dcm
*.SUR
*.nii
*.nii.gz
*.itksnap
*.xlsx
derived/
results/
checksums/
manifest.csv
pairs.csv

.venv/
__pycache__/
*.pyc
.DS_Store

# Cloudflare wrangler's local cache. Holds account identifiers.
.wrangler/

# The trained weights are a derivative of unpublished study data, so they are
# not published with the tool by default. `bundle_web_model.py` writes them
# here for local use and for a deploy; whether they go on a public URL is the
# data owner's decision, not a build-step side effect.
web/model/

# Local seed data for the shared-workspace backend. Creates real named
# accounts for testing, so it carries a person's name and a password and
# must never be committed -- check_public.py would reject it anyway.
server/seed.local.*
server/node_modules/
server/.wrangler/
