{
  "name": "mri-review-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "wrangler d1 migrations apply mri-review --local",
    "migrate:remote": "wrangler d1 migrations apply mri-review --remote",
    "seed": "node seed-user.mjs",
    "dev": "wrangler dev --port 8787",
    "reset": "rm -rf .wrangler/state && npm run migrate",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
